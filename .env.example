# Public client configuration
NEXT_PUBLIC_CONVEX_URL=

# Server-only GitHub credential for public repository discovery.
# Do not use a credential that grants private repository access here.
GITHUB_PUBLIC_TOKEN=

# Convex Auth / GitHub OAuth
CONVEX_SITE_URL=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Base64-encoded 32-byte AES-GCM key used for encrypted user GitHub tokens.
# Leave empty to allow identity-only sign-in without private repository access.
OPENHUB_TOKEN_ENCRYPTION_KEY=

# Used by local/preview setup and future provider adapters.
SITE_URL=http://localhost:3000
